# CyberGuard Enterprise Configuration
PROJECT_NAME=CYBERGUARD
PROJECT_VERSION=1.0.0
ENVIRONMENT=development
DEMO_MODE=True

# Security
SECRET_KEY=cyberguard-enterprise-super-secure-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use SQLite for standalone local execution:
DATABASE_URL=sqlite:///./cyberguard.db
# Or PostgreSQL for production deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberguard

# Risk Scoring Thresholds
RISK_SAFE_MAX=20
RISK_LOW_MAX=40
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=80
RISK_CRITICAL_MIN=81
